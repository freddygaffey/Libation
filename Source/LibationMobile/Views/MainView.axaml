<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LibationMobile.ViewModels"
             xmlns:views="using:LibationMobile.Views"
             x:Class="LibationMobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource Ink}">

	<UserControl.Styles>
		<Style Selector="Button.tab">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource Dust}" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="Padding" Value="0,8,0,6" />
			<Setter Property="CornerRadius" Value="0" />
		</Style>
		<Style Selector="Button.tab.selected">
			<Setter Property="Foreground" Value="{StaticResource Lamp}" />
		</Style>
		<Style Selector="Button.tab:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
		</Style>
	</UserControl.Styles>

	<Grid Name="safeArea" RowDefinitions="*,Auto,Auto,Auto">

		<views:LibraryView Grid.Row="0" IsVisible="{Binding IsLibraryPage}" />
		<views:PodcastsView Grid.Row="0" IsVisible="{Binding IsPodcastsPage}" />
		<views:DownloadsView Grid.Row="0" IsVisible="{Binding IsDownloadsPage}" />

		<TextBlock
			Grid.Row="1"
			Margin="20,8"
			Text="{Binding Error}"
			IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
			TextWrapping="Wrap"
			Foreground="{StaticResource Lamp}" />

		<!-- Mini player: the loaded book, one tap from resuming. -->
		<Border
			Grid.Row="2"
			Background="{StaticResource Slate}"
			IsVisible="{Binding ShowMiniPlayer}">
			<Grid DataContext="{Binding NowPlaying}" x:DataType="vm:NowPlayingViewModel" RowDefinitions="2,Auto">
				<ProgressBar
					Grid.Row="0"
					Height="2"
					MinHeight="2"
					CornerRadius="0"
					Minimum="0"
					Maximum="1"
					Value="{Binding Progress}"
					Foreground="{StaticResource Lamp}"
					Background="Transparent" />
				<Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="12,8">
					<Button
						Grid.Column="0"
						Background="Transparent"
						Padding="0"
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Stretch"
						Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowNowPlayingCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
							<Border Width="44" Height="44" CornerRadius="3" ClipToBounds="True" Background="{StaticResource Ink}">
								<Image Source="{Binding Cover}" Stretch="UniformToFill" />
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center">
								<TextBlock Classes="bookTitle" Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
								<TextBlock Classes="muted" Text="{Binding RemainingText}" FontSize="12" TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</Grid>
					</Button>
					<Button Grid.Column="1" Classes="transport" Command="{Binding SkipBackCommand}" ToolTip.Tip="Skip back">
						<Panel Margin="0,0,0,5">
							<PathIcon Data="{StaticResource IconSkipBack}" Width="26" Height="26" />
							<TextBlock Text="{Binding SkipText}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0" />
						</Panel>
					</Button>
					<Button Grid.Column="2" Classes="transport" Command="{Binding PlayPauseCommand}">
						<Panel>
							<PathIcon Data="{StaticResource IconPlay}" Margin="5,0,0,0" IsVisible="{Binding !IsPlaying}" />
							<PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding IsPlaying}" />
						</Panel>
					</Button>
				</Grid>
			</Grid>
		</Border>

		<!-- The three tabs. -->
		<UniformGrid Grid.Row="3" Columns="3" Background="{StaticResource Ink}" IsVisible="{Binding IsTabPage}">
			<Button Classes="tab" Classes.selected="{Binding IsLibraryPage}" Command="{Binding ShowTabCommand}" CommandParameter="library">
				<StackPanel Spacing="2">
					<PathIcon Data="{StaticResource IconLibrary}" Width="20" Height="20" />
					<TextBlock Text="Library" FontSize="11" HorizontalAlignment="Center" />
				</StackPanel>
			</Button>
			<Button Classes="tab" Classes.selected="{Binding IsPodcastsPage}" Command="{Binding ShowTabCommand}" CommandParameter="podcasts">
				<StackPanel Spacing="2">
					<PathIcon Data="{StaticResource IconPodcast}" Width="20" Height="20" />
					<TextBlock Text="Podcasts" FontSize="11" HorizontalAlignment="Center" />
				</StackPanel>
			</Button>
			<Button Classes="tab" Classes.selected="{Binding IsDownloadsPage}" Command="{Binding ShowTabCommand}" CommandParameter="downloads">
				<StackPanel Spacing="2">
					<PathIcon Data="{StaticResource IconDownloads}" Width="20" Height="20" />
					<TextBlock Text="Downloads" FontSize="11" HorizontalAlignment="Center" />
				</StackPanel>
			</Button>
		</UniformGrid>

		<views:NowPlayingView
			Grid.Row="0"
			Grid.RowSpan="4"
			DataContext="{Binding NowPlaying}"
			IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsNowPlayingPage}" />

		<views:ListeningLogView Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsLogPage}" />
		<views:DetailsView Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsDetailsPage}" />
		<views:SettingsView Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsSettingsPage}" />
		<views:SignInView Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsSignInPage}" />
		<views:BrowserView Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsBrowserPage}" />
	</Grid>
</UserControl>
