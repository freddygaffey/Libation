<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LibationMobile.ViewModels"
             xmlns:controls="using:LibationMobile.Controls"
             xmlns:services="using:LibationMobile.Services"
             x:Class="LibationMobile.Views.DownloadsView"
             x:DataType="vm:MainViewModel">

	<UserControl.Styles>
		<Style Selector="ListBox.rows ListBoxItem">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter, ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter, ListBox.rows ListBoxItem:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.row:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.row:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Hairline}" />
		</Style>
	</UserControl.Styles>

	<UserControl.DataTemplates>
		<DataTemplate DataType="vm:DownloadsHeading">
			<TextBlock Classes="muted" Text="{Binding Text}" FontSize="13" Margin="20,18,20,6" />
		</DataTemplate>
		<!-- A downloaded audiobook: as in the library, without the download button. -->
		<DataTemplate DataType="vm:BookItemViewModel">
			<Grid ColumnDefinitions="*,Auto">
				<Button Classes="row" Background="Transparent" CornerRadius="0" Padding="20,10,8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
					Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenBookCommand}" CommandParameter="{Binding}">
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
						<Border Width="56" Height="56" CornerRadius="3" ClipToBounds="True" Background="{StaticResource Slate}">
							<Image Source="{Binding Cover}" Stretch="UniformToFill" />
						</Border>
						<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
							<TextBlock Classes="bookTitle" Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
							<TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" />
							<ProgressBar Height="2" MinHeight="2" Margin="0,4,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding HasProgress}"
								Foreground="{StaticResource Lamp}" Background="{StaticResource Hairline}" />
						</StackPanel>
					</Grid>
				</Button>
				<Button Grid.Column="1" Classes="transport" Width="40" Height="48" Margin="0,0,4,0" ToolTip.Tip="More">
					<PathIcon Data="{StaticResource IconMore}" Width="18" Height="18" Foreground="{StaticResource Dust}" />
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight">
							<MenuItem Header="Cancel download" IsVisible="{Binding IsDownloading}"
								Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Library.CancelDownloadCommand}" CommandParameter="{Binding}" />
							<MenuItem Header="Remove download" IsVisible="{Binding IsDownloaded}"
								Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveDownloadCommand}" CommandParameter="{Binding}" />
						</MenuFlyout>
					</Button.Flyout>
				</Button>
				<Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Margin="20,0,0,0" Background="{StaticResource Hairline}" />
			</Grid>
		</DataTemplate>
		<!-- A book voiced on the phone: being read, ready, or failed. -->
		<DataTemplate DataType="vm:VoicedRowViewModel">
			<Grid ColumnDefinitions="*,Auto">
				<Button Classes="row" Background="Transparent" CornerRadius="0" Padding="20,10,8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
					Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenVoicedCommand}" CommandParameter="{Binding}">
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
						<Border Width="56" Height="56" CornerRadius="3" ClipToBounds="True" Background="{StaticResource Slate}">
							<Panel>
								<PathIcon Data="{StaticResource IconMic}" Width="24" Height="24" Foreground="{StaticResource Dust}" IsVisible="{Binding HasNoCover}" />
								<Image Source="{Binding Cover}" Stretch="UniformToFill" />
							</Panel>
						</Border>
						<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
							<TextBlock Classes="bookTitle" Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
							<TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
							<ProgressBar Height="2" MinHeight="2" Margin="0,4,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsReading}"
								Foreground="{StaticResource Lamp}" Background="{StaticResource Hairline}" />
						</StackPanel>
					</Grid>
				</Button>
				<Button Grid.Column="1" Classes="transport" Width="40" Height="48" Margin="0,0,4,0" ToolTip.Tip="More">
					<PathIcon Data="{StaticResource IconMore}" Width="18" Height="18" Foreground="{StaticResource Dust}" />
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight">
							<MenuItem Header="Try again" IsVisible="{Binding HasFailed}"
								Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RetryVoicedCommand}" CommandParameter="{Binding}" />
							<MenuItem Header="Delete"
								Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveVoicedCommand}" CommandParameter="{Binding}" />
						</MenuFlyout>
					</Button.Flyout>
				</Button>
				<Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Margin="20,0,0,0" Background="{StaticResource Hairline}" />
			</Grid>
		</DataTemplate>
	</UserControl.DataTemplates>

	<Grid RowDefinitions="Auto,*">
		<Grid ColumnDefinitions="*,Auto" Margin="20,16,12,4">
			<TextBlock Classes="bookTitle" Text="Downloads" FontSize="30" />
			<Button Grid.Column="1" Classes="quiet" Padding="12,6" VerticalAlignment="Center" IsVisible="{Binding Voice.CanVoice}"
				Command="{Binding Voice.OpenCommand}">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
					<TextBlock Text="Voice a book" />
				</StackPanel>
			</Button>
		</Grid>
		<StackPanel Grid.Row="1" Margin="20,40,20,0" Spacing="10" IsVisible="{Binding HasNoDownloads}">
			<TextBlock Classes="bookTitle" Text="Nothing downloaded yet" FontSize="20" />
			<TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
				Text="Download a book from Library or an episode from Podcasts to listen offline. Everything on this phone shows here." />
		</StackPanel>
		<ListBox Grid.Row="1" Classes="rows" ItemsSource="{Binding DownloadRows}" Background="Transparent" />
		<!-- Making a book from a document. -->
		<Border Grid.RowSpan="2" Background="{StaticResource Ink}" DataContext="{Binding Voice}" IsVisible="{Binding IsOpen}" x:DataType="vm:VoiceViewModel">
			<ScrollViewer>
				<StackPanel Margin="20,16,20,32" Spacing="12">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Classes="bookTitle" Text="Voice a book" FontSize="26" VerticalAlignment="Center" />
						<Button Grid.Column="1" Classes="quiet" Content="Cancel" Padding="12,6" Command="{Binding CloseCommand}" />
					</Grid>
					<Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,14"
						Content="Choose a PDF, EPUB or text file" Command="{Binding PickDocumentCommand}" IsEnabled="{Binding !IsBusy}" />
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
						<TextBox Text="{Binding Url}" PlaceholderText="Or a web address of one" TextInputOptions.ContentType="Url" TextInputOptions.AutoCapitalization="False" TextInputOptions.ReturnKeyType="Go" />
						<Button Grid.Column="1" Classes="quiet" Content="Get" Padding="14,8" Command="{Binding FetchUrlCommand}" IsEnabled="{Binding !IsBusy}" />
					</Grid>
					<TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding HasMessage}" />
					<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Foreground="{StaticResource Lamp}" />
					<StackPanel Spacing="12" IsVisible="{Binding HasContent}" Margin="0,8,0,0">
						<TextBlock Classes="muted" Text="{Binding ContentText}" FontSize="13" TextWrapping="Wrap" />
						<TextBox Text="{Binding Title}" PlaceholderText="Title" />
						<TextBox Text="{Binding Author}" PlaceholderText="Author" />
						<TextBlock Text="Voice" FontSize="15" Margin="0,4,0,0" />
						<ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" HorizontalAlignment="Stretch">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="services:VoiceChoice">
									<TextBlock Text="{Binding Label}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,14" Margin="0,8,0,0"
							Background="{StaticResource Lamp}" Foreground="{StaticResource Ink}" FontWeight="SemiBold"
							Content="Make audiobook" Command="{Binding MakeCommand}" />
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
