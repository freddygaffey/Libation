<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LibationMobile.ViewModels"
             xmlns:controls="using:LibationMobile.Controls"
             x:Class="LibationMobile.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel"
             Background="{StaticResource Ink}">

	<UserControl.Styles>
		<Style Selector="Button.row:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.row:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Hairline}" />
		</Style>
		<Style Selector="ListBox.chapters ListBoxItem">
			<Setter Property="Padding" Value="0" />
		</Style>
		<Style Selector="ListBox.chapters ListBoxItem:selected /template/ ContentPresenter, ListBox.chapters ListBoxItem:pointerover /template/ ContentPresenter, ListBox.chapters ListBoxItem:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.labelled">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
			<Setter Property="MinWidth" Value="58" />
			<Setter Property="Height" Value="48" />
			<Setter Property="Padding" Value="4,2" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.labelled:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.labelled:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Hairline}" />
		</Style>
		<Style Selector="TextBlock.chapterTitle">
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
		</Style>
		<Style Selector="TextBlock.chapterTitle.played">
			<Setter Property="Foreground" Value="{StaticResource Dust}" />
		</Style>
		<Style Selector="TextBlock.chapterTitle.current">
			<Setter Property="Foreground" Value="{StaticResource Lamp}" />
		</Style>
	</UserControl.Styles>

	<Panel>
	<Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="24,4,24,20">

		<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
			<!-- Down chevron: Now Playing slides over the library, so "back" points down. -->
			<Button
				Classes="transport"
				Width="48"
				Height="48"
				Margin="-12,0,0,0"
				Command="{Binding $parent[UserControl;1].((vm:MainViewModel)DataContext).GoToLibraryCommand}">
				<PathIcon Data="{StaticResource IconChevronDown}" />
			</Button>
			<!-- Saved on the device; see AudibleAnnotations for why not in the Audible account. -->
			<StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,-8,0">
				<Button Classes="labelled" Command="{Binding AddBookmarkCommand}">
					<StackPanel Spacing="2">
						<PathIcon Data="{StaticResource IconBookmark}" Width="18" Height="18" />
						<TextBlock Text="Bookmark" FontSize="10" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button Classes="labelled" Command="{Binding AddClipCommand}">
					<StackPanel Spacing="2">
						<PathIcon Data="{StaticResource IconClip}" Width="18" Height="18" />
						<TextBlock Text="Clip 30s" FontSize="10" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button Classes="labelled" Command="{Binding ShowAnnotationsCommand}">
					<StackPanel Spacing="2">
						<PathIcon Data="{StaticResource IconBookmarks}" Width="18" Height="18" />
						<TextBlock Text="Saved" FontSize="10" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<Border
			Grid.Row="1"
			Margin="0,8,0,20"
			CornerRadius="4"
			ClipToBounds="True"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Background="{StaticResource Slate}">
			<Image Source="{Binding Cover}" Stretch="Uniform" MaxWidth="420" />
		</Border>

		<StackPanel Grid.Row="2" Spacing="4">
			<TextBlock Classes="bookTitle" Text="{Binding Title}" FontSize="24" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
			<TextBlock Classes="muted" Text="{Binding Author}" FontSize="15" />
			<!-- Tap the chapter to see them all. -->
			<Button Classes="row" Background="Transparent" Padding="0,6,0,2" Margin="0,4,0,0" HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Stretch" IsVisible="{Binding HasChapters}" Command="{Binding ShowChaptersCommand}">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<StackPanel>
						<TextBlock Text="{Binding ChapterText}" FontSize="14" Foreground="{StaticResource Lamp}" TextTrimming="CharacterEllipsis" />
						<TextBlock Classes="muted" Text="{Binding ChapterRemainingText}" FontSize="12" />
					</StackPanel>
					<PathIcon Grid.Column="1" Data="{StaticResource IconChapters}" Width="20" Height="20" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
				</Grid>
			</Button>
			<!-- What just happened: a bookmark added, or the position moved to match another device. -->
			<Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasStatus}" Margin="0,4,0,0">
				<TextBlock Classes="muted" Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
				<Button Grid.Column="1" Classes="quiet" Content="Undo" Padding="8,2" IsVisible="{Binding CanUndoSync}" Command="{Binding UndoSyncCommand}" />
			</Grid>
		</StackPanel>

		<StackPanel Grid.Row="3" Margin="0,12,0,0">
			<Slider
				Classes="scrubber"
				Minimum="0"
				Maximum="{Binding DurationSeconds}"
				Value="{Binding PositionSeconds}" />
			<Grid ColumnDefinitions="*,*" Margin="0,-6,0,0">
				<TextBlock Classes="muted" Text="{Binding ElapsedText}" FontSize="12" />
				<TextBlock Grid.Column="1" Classes="muted" Text="{Binding RemainingText}" FontSize="12" HorizontalAlignment="Right" />
			</Grid>
		</StackPanel>

		<UniformGrid Grid.Row="4" Columns="5" Margin="0,16,0,8">
			<Button Classes="transport" HorizontalAlignment="Center" Command="{Binding PreviousChapterCommand}" IsEnabled="{Binding HasChapters}">
				<PathIcon Data="{StaticResource IconPrevious}" />
			</Button>
			<Button Classes="transport" HorizontalAlignment="Center" Command="{Binding SkipBackCommand}">
				<Panel>
					<PathIcon Data="{StaticResource IconSkipBack}" Width="30" Height="30" />
					<TextBlock Text="30" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" />
				</Panel>
			</Button>
			<Button Classes="transport play" HorizontalAlignment="Center" Command="{Binding PlayPauseCommand}">
				<Panel>
					<PathIcon Data="{StaticResource IconPlay}" Width="28" Height="28" IsVisible="{Binding !IsPlaying}" />
					<PathIcon Data="{StaticResource IconPause}" Width="28" Height="28" IsVisible="{Binding IsPlaying}" />
				</Panel>
			</Button>
			<Button Classes="transport" HorizontalAlignment="Center" Command="{Binding SkipForwardCommand}">
				<Panel>
					<PathIcon Data="{StaticResource IconSkipForward}" Width="30" Height="30" />
					<TextBlock Text="30" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" />
				</Panel>
			</Button>
			<Button Classes="transport" HorizontalAlignment="Center" Command="{Binding NextChapterCommand}" IsEnabled="{Binding HasChapters}">
				<PathIcon Data="{StaticResource IconNext}" />
			</Button>
		</UniformGrid>

		<!-- Speed: the one bold element on the screen. -->
		<Border Grid.Row="5" Background="{StaticResource Slate}" CornerRadius="6" Padding="16,12,16,10" Margin="0,8,0,0">
			<StackPanel Spacing="10">
				<Grid ColumnDefinitions="*,Auto,Auto">
					<TextBlock
						Text="{Binding SpeedText}"
						FontFamily="{StaticResource DisplayFont}"
						FontWeight="Light"
						FontSize="52"
						VerticalAlignment="Center" />
					<Button Grid.Column="1" Classes="transport" Width="48" Height="48" Command="{Binding SlowerStepCommand}">
						<PathIcon Data="{StaticResource IconMinus}" />
					</Button>
					<Button Grid.Column="2" Classes="transport" Width="48" Height="48" Command="{Binding FasterStepCommand}">
						<PathIcon Data="{StaticResource IconPlus}" />
					</Button>
				</Grid>
				<controls:SpeedRail
					Speed="{Binding Speed}"
					Minimum="{x:Static vm:NowPlayingViewModel.MIN_SPEED}"
					Maximum="{x:Static vm:NowPlayingViewModel.MAX_SPEED}"
					Stops="{x:Static vm:NowPlayingViewModel.SpeedStops}" />
			</StackPanel>
		</Border>
	</Grid>

	<!-- Chapter list: over the player, so closing it returns exactly where you were. -->
	<Grid RowDefinitions="Auto,*" Background="{StaticResource Ink}" IsVisible="{Binding IsChapterListOpen}">
		<Grid ColumnDefinitions="Auto,*" Margin="12,4,24,4">
			<Button Classes="transport" Width="48" Height="48" Command="{Binding HideChaptersCommand}" ToolTip.Tip="Close chapters">
				<PathIcon Data="{StaticResource IconChevronDown}" />
			</Button>
			<TextBlock Grid.Column="1" Classes="bookTitle" Text="Chapters" FontSize="22" VerticalAlignment="Center" Margin="4,0,0,0" />
		</Grid>
		<ListBox Grid.Row="1" Name="chapterList" Classes="chapters" ItemsSource="{Binding ChapterRows}" Background="Transparent">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:ChapterRowViewModel">
					<Button Classes="row" Background="Transparent" CornerRadius="0" Padding="24,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
						BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}"
						Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).JumpToChapterCommand}" CommandParameter="{Binding}">
						<Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
							<TextBlock Classes="muted" Text="{Binding Number}" FontSize="13" VerticalAlignment="Center" />
							<StackPanel Grid.Column="1" VerticalAlignment="Center">
								<TextBlock Classes="chapterTitle" Classes.played="{Binding IsPlayed}" Classes.current="{Binding IsCurrent}"
									Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" />
								<TextBlock Text="Playing" FontSize="11" Foreground="{StaticResource Lamp}" IsVisible="{Binding IsCurrent}" Margin="0,2,0,0" />
							</StackPanel>
							<TextBlock Grid.Column="2" Classes="muted" Text="{Binding LengthText}" FontSize="13" VerticalAlignment="Center" />
						</Grid>
					</Button>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>

	<!-- Bookmarks and clips saved on the device, plus any on Audible's older annotation server. -->
	<Grid RowDefinitions="Auto,*" Background="{StaticResource Ink}" IsVisible="{Binding IsAnnotationListOpen}">
		<Grid ColumnDefinitions="Auto,*" Margin="12,4,24,4">
			<Button Classes="transport" Width="48" Height="48" Command="{Binding HideAnnotationsCommand}" ToolTip.Tip="Close">
				<PathIcon Data="{StaticResource IconChevronDown}" />
			</Button>
			<TextBlock Grid.Column="1" Classes="bookTitle" Text="Bookmarks and clips" FontSize="22" VerticalAlignment="Center" Margin="4,0,0,0" />
		</Grid>
		<StackPanel Grid.Row="1" Margin="24,32,24,0" Spacing="10" IsVisible="{Binding !HasAnnotations}">
			<TextBlock Classes="bookTitle" Text="Nothing saved in this book yet" FontSize="18" />
			<TextBlock Classes="muted" TextWrapping="Wrap"
				Text="While listening, tap Bookmark to mark your place, or Clip to keep the last 30 seconds. They are saved on this phone." />
		</StackPanel>
		<ListBox Grid.Row="1" Classes="chapters" ItemsSource="{Binding Annotations}" Background="Transparent" IsVisible="{Binding HasAnnotations}">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:AnnotationRowViewModel">
					<Grid ColumnDefinitions="*,Auto">
						<Button Classes="row" Background="Transparent" CornerRadius="0" Padding="24,14,8,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
							Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).OpenAnnotationCommand}" CommandParameter="{Binding}">
							<Grid ColumnDefinitions="28,*" ColumnSpacing="8">
								<Panel VerticalAlignment="Center">
									<PathIcon Data="{StaticResource IconClip}" Width="16" Height="16" Foreground="{StaticResource Lamp}" IsVisible="{Binding IsClip}" />
									<PathIcon Data="{StaticResource IconBookmark}" Width="16" Height="16" Foreground="{StaticResource Lamp}" IsVisible="{Binding !IsClip}" />
								</Panel>
								<StackPanel Grid.Column="1">
									<TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
									<TextBlock Classes="muted" Text="{Binding DetailText}" FontSize="12" TextWrapping="Wrap" />
								</StackPanel>
							</Grid>
						</Button>
						<Button Grid.Column="1" Classes="transport" Width="40" Height="48" Margin="0,0,12,0" ToolTip.Tip="More">
							<PathIcon Data="{StaticResource IconMore}" Width="18" Height="18" Foreground="{StaticResource Dust}" />
							<Button.Flyout>
								<MenuFlyout Placement="BottomEdgeAlignedRight">
									<MenuItem Header="Delete"
										Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).DeleteAnnotationCommand}" CommandParameter="{Binding}" />
								</MenuFlyout>
							</Button.Flyout>
						</Button>
						<Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Margin="24,0,0,0" Background="{StaticResource Hairline}" />
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>
	</Panel>
</UserControl>
