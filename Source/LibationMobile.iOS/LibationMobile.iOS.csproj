<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>LibationMobile.iOS</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The icon set in Assets.xcassets. Rendered from LibationMobile/Icon/icon.svg by render-icons.sh. -->
    <AppIcon>AppIcon</AppIcon>
    <ApplicationId>io.github.freddygaffey.libationmobile</ApplicationId>
    <ApplicationTitle>Libation</ApplicationTitle>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- speechwarp is not on nuget.org yet; its package is kept in LocalPackages. -->
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)..\LibationMobile\LocalPackages</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
  </ItemGroup>

  <!-- iOS plays through AVFoundation (see AudioBackend in AppDelegate), so SoundFlow's native libraries are not
       needed. Its iOS frameworks are device-only and would otherwise be linked into simulator builds and fail. -->
  <ItemGroup>
    <PackageReference Include="SoundFlow" Version="1.4.1" ExcludeAssets="native;build;buildTransitive" />
    <PackageReference Include="SoundFlow.Codecs.FFMpeg" Version="1.4.0" ExcludeAssets="native;build;buildTransitive" />
  </ItemGroup>

  <!-- Pulled in by Dinah.Core for desktop keychain storage (CredentialManagerOsSecretStore), which this app never
       uses: tokens are kept in the app's own file. It imports macOS's System.framework, which iOS does not have. -->
  <ItemGroup>
    <PackageReference Include="Devlooped.CredentialManager" Version="2.7.0" ExcludeAssets="all" />
  </ItemGroup>

  <!-- The home-screen widget, from Widget/build-widget.sh. Left out when that has not been run, such as on a
       machine without Xcode's signing set up; the app then runs without it. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Widget/**</DefaultItemExcludes>
    <_WidgetProducts>$(MSBuildThisFileDirectory)Widget/build/Build/Products</_WidgetProducts>
    <_WidgetPlatform Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">Release-iphoneos</_WidgetPlatform>
    <_WidgetPlatform Condition="'$(RuntimeIdentifier)' != 'ios-arm64'">Release-iphonesimulator</_WidgetPlatform>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(_WidgetProducts)/$(_WidgetPlatform)/LibationWidgetExtension.appex') And Exists('$(_WidgetProducts)/$(_WidgetPlatform)/LibationWidgetBridge.framework')">
    <AdditionalAppExtensions Include="$(_WidgetProducts)">
      <Name>LibationWidgetExtension</Name>
      <BuildOutput>$(_WidgetPlatform)</BuildOutput>
      <CodesignEntitlements Condition="'$(_WidgetPlatform)' == 'Release-iphoneos'">$(_WidgetProducts)/LibationWidgetExtension.entitlements</CodesignEntitlements>
    </AdditionalAppExtensions>
    <NativeReference Include="$(_WidgetProducts)/$(_WidgetPlatform)/LibationWidgetBridge.framework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibationMobile\LibationMobile.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>

</Project>
