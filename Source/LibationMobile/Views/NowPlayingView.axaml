<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LibationMobile.ViewModels"
             xmlns:controls="using:LibationMobile.Controls"
             x:Class="LibationMobile.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel"
             Background="{StaticResource Ink}">

	<UserControl.Styles>
		<!-- The place the listener probably fell asleep, in a book's history. -->
		<Style Selector="Button.asleep /template/ ContentPresenter">
			<Setter Property="BorderBrush" Value="{StaticResource Lamp}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="Button.row:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.row:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Hairline}" />
		</Style>
		<Style Selector="ListBox.chapters ListBoxItem">
			<Setter Property="Padding" Value="0" />
		</Style>
		<Style Selector="ListBox.chapters ListBoxItem:selected /template/ ContentPresenter, ListBox.chapters ListBoxItem:pointerover /template/ ContentPresenter, ListBox.chapters ListBoxItem:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.choice">
			<Setter Property="Background" Value="{StaticResource Ink}" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
			<Setter Property="Padding" Value="0,10" />
			<Setter Property="Margin" Value="3,0" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>
		<Style Selector="Button.labelled">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
			<Setter Property="MinWidth" Value="58" />
			<Setter Property="Height" Value="48" />
			<Setter Property="Padding" Value="4,2" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.labelled:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.labelled:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Hairline}" />
		</Style>
		<Style Selector="TextBlock.chapterTitle">
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
		</Style>
		<Style Selector="TextBlock.chapterTitle.played">
			<Setter Property="Foreground" Value="{StaticResource Dust}" />
		</Style>
		<Style Selector="TextBlock.chapterTitle.current">
			<Setter Property="Foreground" Value="{StaticResource Lamp}" />
		</Style>
	</UserControl.Styles>

	<Panel>
	<Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="24,4,24,20">

		<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
			<!-- Down chevron: Now Playing slides over the library, so "back" points down. -->
			<Button
				Classes="transport"
				Width="48"
				Height="48"
				Margin="-12,0,0,0"
				Command="{Binding $parent[UserControl;1].((vm:MainViewModel)DataContext).GoToLibraryCommand}">
				<PathIcon Data="{StaticResource IconChevronDown}" />
			</Button>
			<!-- Saved on the device; see AudibleAnnotations for why not in the Audible account. -->
			<StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,-8,0">
				<Button Classes="labelled" Command="{Binding AddBookmarkCommand}">
					<StackPanel Spacing="2">
						<PathIcon Data="{StaticResource IconBookmark}" Width="18" Height="18" />
						<TextBlock Text="Bookmark" FontSize="10" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button Classes="labelled" Command="{Binding AddClipCommand}">
					<StackPanel Spacing="2">
						<PathIcon Data="{StaticResource IconClip}" Width="18" Height="18" />
						<TextBlock Text="Clip" FontSize="10" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button Classes="labelled" Command="{Binding $parent[UserControl;1].((vm:MainViewModel)DataContext).ShowPlayingDetailsCommand}">
					<StackPanel Spacing="2">
						<PathIcon Data="{StaticResource IconInfo}" Width="18" Height="18" />
						<TextBlock Text="Details" FontSize="10" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button Classes="labelled" Command="{Binding ShowAnnotationsCommand}">
					<StackPanel Spacing="2">
						<PathIcon Data="{StaticResource IconBookmarks}" Width="18" Height="18" />
						<TextBlock Text="Saved" FontSize="10" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button Classes="labelled" Command="{Binding ShowHistoryCommand}">
					<StackPanel Spacing="2">
						<PathIcon Data="{StaticResource IconHistory}" Width="18" Height="18" />
						<TextBlock Text="History" FontSize="10" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<Border
			Grid.Row="1"
			Margin="0,8,0,20"
			CornerRadius="4"
			ClipToBounds="True"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Background="{StaticResource Slate}">
			<Image Source="{Binding Cover}" Stretch="Uniform" MaxWidth="420" />
		</Border>

		<StackPanel Grid.Row="2" Spacing="4">
			<TextBlock Classes="bookTitle" Text="{Binding Title}" FontSize="{Binding TitleFontSize}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
			<TextBlock Classes="muted" Text="{Binding Author}" FontSize="14" TextTrimming="CharacterEllipsis" />
			<!-- Tap the chapter to see them all. -->
			<Button Classes="row" Background="Transparent" Padding="0,6,0,2" Margin="0,4,0,0" HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Stretch" IsVisible="{Binding HasChapters}" Command="{Binding ShowChaptersCommand}">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<StackPanel>
						<TextBlock Text="{Binding ChapterText}" FontSize="14" Foreground="{StaticResource Lamp}" TextTrimming="CharacterEllipsis" />
						<TextBlock Classes="muted" Text="{Binding ScrubberDetailText}" FontSize="12" />
					</StackPanel>
					<PathIcon Grid.Column="1" Data="{StaticResource IconChapters}" Width="20" Height="20" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
				</Grid>
			</Button>
			<!-- What just happened: a bookmark added, or the position moved to match another device. -->
			<Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasStatus}" Margin="0,4,0,0">
				<TextBlock Classes="muted" Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
				<Button Grid.Column="1" Classes="quiet" Content="Undo" Padding="8,2" IsVisible="{Binding CanUndoSync}" Command="{Binding UndoSyncCommand}" />
			</Grid>
		</StackPanel>

		<StackPanel Grid.Row="3" Margin="0,12,0,0">
			<!-- Seeks only while touched: see NowPlayingViewModel.IsScrubbing. -->
			<Slider
				Name="scrubber"
				Classes="scrubber"
				Minimum="0"
				Maximum="{Binding ScrubberMaximum}"
				Value="{Binding ScrubberSeconds}" />
			<Grid ColumnDefinitions="*,*" Margin="0,-6,0,0">
				<TextBlock Classes="muted" Text="{Binding ScrubberElapsedText}" FontSize="12" />
				<TextBlock Grid.Column="1" Classes="muted" Text="{Binding ScrubberRemainingText}" FontSize="12" HorizontalAlignment="Right" />
			</Grid>
		</StackPanel>

		<UniformGrid Grid.Row="4" Columns="5" Margin="0,16,0,8">
			<Button Classes="transport" HorizontalAlignment="Center" Command="{Binding PreviousChapterCommand}" IsEnabled="{Binding HasChapters}">
				<PathIcon Data="{StaticResource IconPrevious}" />
			</Button>
			<Button Classes="transport" HorizontalAlignment="Center" Command="{Binding SkipBackCommand}">
				<Panel Margin="0,0,0,6">
					<PathIcon Data="{StaticResource IconSkipBack}" Width="30" Height="30" />
					<TextBlock Text="{Binding SkipText}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7,0,0" />
				</Panel>
			</Button>
			<Button Classes="transport play" HorizontalAlignment="Center" Command="{Binding PlayPauseCommand}">
				<Panel>
					<!-- A triangle looks centred by its weight, which is left of the middle of its box. -->
					<PathIcon Data="{StaticResource IconPlay}" Width="28" Height="28" Margin="7,0,0,0" IsVisible="{Binding !IsPlaying}" />
					<PathIcon Data="{StaticResource IconPause}" Width="28" Height="28" IsVisible="{Binding IsPlaying}" />
				</Panel>
			</Button>
			<Button Classes="transport" HorizontalAlignment="Center" Command="{Binding SkipForwardCommand}">
				<Panel Margin="0,0,0,6">
					<PathIcon Data="{StaticResource IconSkipForward}" Width="30" Height="30" />
					<TextBlock Text="{Binding SkipText}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7,0,0" />
				</Panel>
			</Button>
			<Button Classes="transport" HorizontalAlignment="Center" Command="{Binding NextChapterCommand}" IsEnabled="{Binding HasChapters}">
				<PathIcon Data="{StaticResource IconNext}" />
			</Button>
		</UniformGrid>

		<!-- Speed: the one bold element on the screen. -->
		<Border Grid.Row="5" Background="{StaticResource Slate}" CornerRadius="6" Padding="16,12,16,10" Margin="0,8,0,0">
			<StackPanel Spacing="10">
				<!-- Blind training: no speed shown, only that a block is playing. -->
				<StackPanel IsVisible="{Binding IsBlindMode}" Spacing="2" Margin="0,4,0,0">
					<TextBlock Text="Blind training" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="32" />
					<TextBlock Classes="muted" Text="{Binding TrainingText}" FontSize="13" />
					<TextBlock Classes="muted" Text="The speed is hidden so the trainer can try speeds you would not pick. Switch modes below to see it." FontSize="11" TextWrapping="Wrap" />
				</StackPanel>
				<Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowsSpeed}">
					<StackPanel VerticalAlignment="Center">
						<TextBlock
							Text="{Binding SpeedText}"
							FontFamily="{StaticResource DisplayFont}"
							FontWeight="Light"
							FontSize="52" />
						<!-- Measured from the audio: the rate speech research uses, for comparing with others. -->
						<TextBlock Classes="muted" Text="{Binding SyllableRateText}" FontSize="12"
							ToolTip.Tip="Estimated from the audio, within about 10%. Untrained listeners manage about 8; trained blind screen-reader users 17 to 22."
							IsVisible="{Binding SyllableRateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					</StackPanel>
					<Button Grid.Column="1" Classes="transport" Width="48" Height="48" Command="{Binding SlowerStepCommand}">
						<PathIcon Data="{StaticResource IconMinus}" />
					</Button>
					<Button Grid.Column="2" Classes="transport" Width="48" Height="48" Command="{Binding FasterStepCommand}">
						<PathIcon Data="{StaticResource IconPlus}" />
					</Button>
				</Grid>
				<Border Background="{StaticResource Lamp}" CornerRadius="6" Padding="10,6" IsVisible="{Binding IsTrialPlaying}">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="{Binding TrialStatus}" Foreground="{StaticResource Ink}" FontSize="13" VerticalAlignment="Center" />
						<Button Grid.Column="1" Content="Stop" Padding="10,4" Background="Transparent" Foreground="{StaticResource Ink}" Command="{Binding CancelTrialCommand}" />
					</Grid>
				</Border>
				<controls:SpeedRail IsVisible="{Binding ShowsSpeed}"
					Speed="{Binding Speed}"
					Minimum="{x:Static vm:NowPlayingViewModel.MIN_SPEED}"
					Maximum="{x:Static vm:NowPlayingViewModel.MAX_SPEED}"
					Stops="{x:Static vm:NowPlayingViewModel.SpeedStops}" />
				<!-- Training mode: warm up from a comfortable speed to this one. Set up in Settings, Speed listening. -->
				<Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,-2,0,0">
					<!-- Speed profile: Casual, School, Hard, Max. Set up in Settings. -->
					<Button Classes="quiet" Padding="10,6" Margin="-10,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Mode: profile, training, method">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock Text="{Binding ProfileText}" FontSize="14" Foreground="{StaticResource Lamp}" />
							<PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" Foreground="{StaticResource Lamp}" />
						</StackPanel>
						<Button.Flyout>
							<!-- The mode panel: profile, training and method, without leaving the book. -->
							<Flyout Placement="TopEdgeAlignedLeft">
								<StackPanel Width="300" Spacing="10" Margin="4">
									<TextBlock Text="Profile" FontSize="13" Foreground="{StaticResource Dust}" />
									<ItemsControl ItemsSource="{Binding Profiles}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:ProfileChoice">
												<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6"
													Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).ChooseProfileCommand}" CommandParameter="{Binding}">
													<StackPanel Spacing="1">
														<Grid ColumnDefinitions="*,Auto">
															<TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
															<TextBlock Grid.Column="1" Text="In use" FontSize="11" Foreground="{StaticResource Lamp}" IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
														</Grid>
														<TextBlock Text="{Binding Purpose}" FontSize="12" TextWrapping="Wrap" />
														<TextBlock Classes="muted" Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" />
													</StackPanel>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsCustomProfile}"
										Text="Custom in use: your own settings from Settings, Speed, Advanced." />

									<Border Height="1" Background="{StaticResource Hairline}" />
									<TextBlock Text="Mode" FontSize="13" Foreground="{StaticResource Dust}" />
									<UniformGrid Columns="3">
										<ToggleButton Content="You choose" IsChecked="{Binding IsNormalMode, Mode=OneWay}" Command="{Binding SetListeningModeCommand}" CommandParameter="normal" Padding="6,8" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
										<ToggleButton Content="Training" IsChecked="{Binding IsTrainingMode, Mode=OneWay}" Command="{Binding SetListeningModeCommand}" CommandParameter="training" Padding="6,8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
										<ToggleButton Content="Blind" IsChecked="{Binding IsBlindMode, Mode=OneWay}" Command="{Binding SetListeningModeCommand}" CommandParameter="blind" Padding="6,8" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
									</UniformGrid>
									<StackPanel Spacing="6" IsVisible="{Binding !IsNormalMode}">
										<TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
											Text="Training: the plan sets the speed, shown. Blind: the speed is hidden everywhere, and some blocks try untested speeds or repeat the last one, to learn where your edge is." />
										<TextBlock Text="Plan" FontSize="13" Foreground="{StaticResource Dust}" />
										<UniformGrid Columns="4">
											<ToggleButton Content="Ramp" IsChecked="{Binding IsPlanRamp, Mode=OneWay}" Command="{Binding SetPlanCommand}" CommandParameter="ramp" Padding="2,6" Margin="0,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" />
											<ToggleButton Content="Intervals" IsChecked="{Binding IsPlanIntervals, Mode=OneWay}" Command="{Binding SetPlanCommand}" CommandParameter="intervals" Padding="2,6" Margin="1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" />
											<ToggleButton Content="Pyramid" IsChecked="{Binding IsPlanPyramid, Mode=OneWay}" Command="{Binding SetPlanCommand}" CommandParameter="pyramid" Padding="2,6" Margin="1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" />
											<ToggleButton Content="Tracking" IsChecked="{Binding IsPlanTracking, Mode=OneWay}" Command="{Binding SetPlanCommand}" CommandParameter="tracking" Padding="2,6" Margin="3,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" />
										</UniformGrid>
										<Grid ColumnDefinitions="*,Auto,Auto">
											<TextBlock Text="{Binding TrainingStartText}" FontSize="13" VerticalAlignment="Center" />
											<Button Grid.Column="1" Classes="quiet" Content="−" Padding="14,4" Command="{Binding TrainingStartHigherCommand}" ToolTip.Tip="Nearer the book's speed" />
											<Button Grid.Column="2" Classes="quiet" Content="+" Padding="14,4" Command="{Binding TrainingStartLowerCommand}" ToolTip.Tip="Further below: a gentler warm-up" />
										</Grid>
									</StackPanel>

									<Border Height="1" Background="{StaticResource Hairline}" />
									<Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,8" Command="{Binding StartTrialCommand}" IsVisible="{Binding !IsTrialRunning}">
										<StackPanel Spacing="1">
											<TextBlock Text="Run a blind trial" FontSize="15" />
											<TextBlock Classes="muted" Text="Two 2-minute parts with one setting changed, not shown. Rate each, then see which it was." FontSize="11" TextWrapping="Wrap" />
										</StackPanel>
									</Button>

									<Border Height="1" Background="{StaticResource Hairline}" />
									<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
										<TextBlock Text="Method" FontSize="15" VerticalAlignment="Center" />
										<ToggleButton Grid.Column="1" Content="Speedy" IsChecked="{Binding IsSpeedy, Mode=OneWay}" Command="{Binding SetMethodCommand}" CommandParameter="speedy" Padding="12,6" />
										<ToggleButton Grid.Column="2" Content="Original" IsChecked="{Binding IsOriginal, Mode=OneWay}" Command="{Binding SetMethodCommand}" CommandParameter="original" Padding="12,6" />
									</Grid>
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>
					<!-- Sleep timer: a set time of listening, or the end of the chapter. -->
					<Button Grid.Column="1" Classes="quiet" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Sleep timer">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<PathIcon Data="{StaticResource IconMoon}" Width="14" Height="14" Foreground="{StaticResource Lamp}" />
							<TextBlock Text="{Binding SleepTimerText}" FontSize="14" Foreground="{StaticResource Lamp}" />
						</StackPanel>
						<Button.Flyout>
							<Flyout Placement="TopEdgeAlignedLeft">
								<StackPanel Width="220" Spacing="2" Margin="4">
									<TextBlock Text="Sleep timer" FontSize="13" Foreground="{StaticResource Dust}" Margin="8,0,0,6" />
									<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" Padding="8,8" Content="5 minutes" Command="{Binding SetSleepTimerCommand}" CommandParameter="5" />
									<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" Padding="8,8" Content="10 minutes" Command="{Binding SetSleepTimerCommand}" CommandParameter="10" />
									<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" Padding="8,8" Content="15 minutes" Command="{Binding SetSleepTimerCommand}" CommandParameter="15" />
									<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" Padding="8,8" Content="30 minutes" Command="{Binding SetSleepTimerCommand}" CommandParameter="30" />
									<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" Padding="8,8" Content="45 minutes" Command="{Binding SetSleepTimerCommand}" CommandParameter="45" />
									<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" Padding="8,8" Content="1 hour" Command="{Binding SetSleepTimerCommand}" CommandParameter="60" />
									<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" Padding="8,8" Content="1½ hours" Command="{Binding SetSleepTimerCommand}" CommandParameter="90" />
									<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" Padding="8,8" Content="End of chapter" Command="{Binding SetSleepTimerCommand}" CommandParameter="0" />
									<Button Classes="row" Background="Transparent" HorizontalAlignment="Stretch" Padding="8,8" Content="Off" Command="{Binding SetSleepTimerCommand}" CommandParameter="off"
										IsVisible="{Binding IsSleepTimerOn}" />
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>
					<StackPanel Grid.Column="2" VerticalAlignment="Center">
						<TextBlock Text="Training" FontSize="14" HorizontalAlignment="Right" />
						<TextBlock Text="{Binding TrainingText}" FontSize="12" Foreground="{StaticResource Lamp}" TextWrapping="Wrap" TextAlignment="Right" IsVisible="{Binding IsTrainingMode}" />
					</StackPanel>
					<ToggleSwitch Grid.Column="3" IsChecked="{Binding TrainingEnabled}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
			</StackPanel>
		</Border>
	</Grid>


	<!-- Training: how well the block just played was followed. Playback carries on; the card goes in 20 seconds. -->
	<Border VerticalAlignment="Top" Margin="16,60,16,0" Padding="12,10" CornerRadius="12" Background="{StaticResource Slate}"
		BorderBrush="{StaticResource Lamp}" BorderThickness="1" IsVisible="{Binding IsAskingBlock}">
		<StackPanel Spacing="8">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Text="How well are you following?" FontSize="15" VerticalAlignment="Center" />
				<Button Grid.Column="1" Classes="quiet" Content="Skip" Padding="8,2" Command="{Binding SkipBlockCommand}" />
			</Grid>
			<UniformGrid Columns="5">
				<Button Classes="choice" Content="1" Command="{Binding RateBlockCommand}" CommandParameter="1" />
				<Button Classes="choice" Content="2" Command="{Binding RateBlockCommand}" CommandParameter="2" />
				<Button Classes="choice" Content="3" Command="{Binding RateBlockCommand}" CommandParameter="3" />
				<Button Classes="choice" Content="4" Command="{Binding RateBlockCommand}" CommandParameter="4" />
				<Button Classes="choice" Content="5" Command="{Binding RateBlockCommand}" CommandParameter="5" />
			</UniformGrid>
		</StackPanel>
	</Border>

	<!-- Questions for the listener's own research: after a session, and during a blind trial. -->
	<!-- Auto-pause when asleep: the fade, then where to go back to. -->
	<Border VerticalAlignment="Bottom" Margin="16,0,16,24" Padding="16,14" CornerRadius="12" Background="{StaticResource Slate}"
		BorderBrush="{StaticResource Lamp}" BorderThickness="1" IsVisible="{Binding IsFadingForSleep}">
		<StackPanel Spacing="10">
			<TextBlock Text="{Binding SleepFadeText}" FontSize="16" TextWrapping="Wrap" />
			<Button Classes="quiet" Content="Keep listening" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10"
				Command="{Binding KeepListeningCommand}" />
		</StackPanel>
	</Border>
	<Border VerticalAlignment="Bottom" Margin="16,0,16,24" Padding="16,14" CornerRadius="12" Background="{StaticResource Slate}"
		BorderBrush="{StaticResource Lamp}" BorderThickness="1" IsVisible="{Binding HasAsleepPlace}">
		<StackPanel Spacing="10">
			<TextBlock Text="{Binding AsleepPlaceText}" FontSize="15" TextWrapping="Wrap" />
			<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
				<Button Classes="quiet" Content="Stay here" Padding="12,8" Command="{Binding DismissAsleepPlaceCommand}" />
				<Button Classes="quiet" Content="Go back there" Padding="12,8" Command="{Binding GoBackToAsleepPlaceCommand}" />
			</StackPanel>
		</StackPanel>
	</Border>
	<Border VerticalAlignment="Bottom" Margin="16,0,16,24" Padding="16,14" CornerRadius="12" Background="{StaticResource Slate}"
		BorderBrush="{StaticResource Lamp}" BorderThickness="1"
		IsVisible="{Binding IsAskingFollow}">
		<StackPanel Spacing="10">
			<TextBlock Text="How well did you follow that?" FontSize="16" />
			<TextBlock Classes="muted" Text="1 lost it · 3 got the gist · 5 every word" FontSize="12" />
			<UniformGrid Columns="5">
				<Button Classes="choice" Content="1" Command="{Binding RateFollowCommand}" CommandParameter="1" />
				<Button Classes="choice" Content="2" Command="{Binding RateFollowCommand}" CommandParameter="2" />
				<Button Classes="choice" Content="3" Command="{Binding RateFollowCommand}" CommandParameter="3" />
				<Button Classes="choice" Content="4" Command="{Binding RateFollowCommand}" CommandParameter="4" />
				<Button Classes="choice" Content="5" Command="{Binding RateFollowCommand}" CommandParameter="5" />
			</UniformGrid>
			<Button Classes="quiet" Content="Skip" HorizontalAlignment="Right" Padding="10,4" Command="{Binding SkipFollowCommand}" />
		</StackPanel>
	</Border>
	<Border VerticalAlignment="Bottom" Margin="16,0,16,24" Padding="16,14" CornerRadius="12" Background="{StaticResource Slate}"
		BorderBrush="{StaticResource Lamp}" BorderThickness="1"
		IsVisible="{Binding IsTrialRunning}">
		<Panel>
			<StackPanel Spacing="10" IsVisible="{Binding IsAskingTrialFollow}">
				<TextBlock Text="{Binding TrialQuestion}" FontSize="16" />
				<TextBlock Classes="muted" Text="1 lost it · 3 got the gist · 5 every word" FontSize="12" />
				<UniformGrid Columns="5">
					<Button Classes="choice" Content="1" Command="{Binding RateTrialPartCommand}" CommandParameter="1" />
					<Button Classes="choice" Content="2" Command="{Binding RateTrialPartCommand}" CommandParameter="2" />
					<Button Classes="choice" Content="3" Command="{Binding RateTrialPartCommand}" CommandParameter="3" />
					<Button Classes="choice" Content="4" Command="{Binding RateTrialPartCommand}" CommandParameter="4" />
					<Button Classes="choice" Content="5" Command="{Binding RateTrialPartCommand}" CommandParameter="5" />
				</UniformGrid>
				<Button Classes="quiet" Content="Stop the trial" HorizontalAlignment="Right" Padding="10,4" Command="{Binding CancelTrialCommand}" />
			</StackPanel>
			<StackPanel Spacing="10" IsVisible="{Binding IsAskingPreference}">
				<TextBlock Text="Which was easier to follow?" FontSize="16" />
				<UniformGrid Columns="3">
					<Button Classes="choice" Content="Part 1" Command="{Binding PreferTrialPartCommand}" CommandParameter="-1" />
					<Button Classes="choice" Content="Same" Command="{Binding PreferTrialPartCommand}" CommandParameter="0" />
					<Button Classes="choice" Content="Part 2" Command="{Binding PreferTrialPartCommand}" CommandParameter="1" />
				</UniformGrid>
			</StackPanel>
			<StackPanel Spacing="10" IsVisible="{Binding IsShowingTrialResult}">
				<TextBlock Text="What you heard" FontSize="16" />
				<TextBlock Text="{Binding TrialResult}" FontSize="13" TextWrapping="Wrap" />
				<TextBlock Classes="muted" Text="Saved. Results build up on the stats page." FontSize="12" />
				<Button Classes="quiet" Content="Back to the book" HorizontalAlignment="Right" Padding="10,4" Command="{Binding FinishTrialCommand}" />
			</StackPanel>
		</Panel>
	</Border>

	<!-- Chapter list: over the player, so closing it returns exactly where you were. -->
	<Grid RowDefinitions="Auto,*" Background="{StaticResource Ink}" IsVisible="{Binding IsChapterListOpen}">
		<Grid ColumnDefinitions="Auto,*" Margin="12,4,24,4">
			<Button Classes="transport" Width="48" Height="48" Command="{Binding HideChaptersCommand}" ToolTip.Tip="Close chapters">
				<PathIcon Data="{StaticResource IconChevronDown}" />
			</Button>
			<TextBlock Grid.Column="1" Classes="bookTitle" Text="Chapters" FontSize="22" VerticalAlignment="Center" Margin="4,0,0,0" />
		</Grid>
		<ListBox Grid.Row="1" Name="chapterList" Classes="chapters" ItemsSource="{Binding ChapterRows}" Background="Transparent">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:ChapterRowViewModel">
					<Button Classes="row" Background="Transparent" CornerRadius="0" Padding="24,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
						BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}"
						Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).JumpToChapterCommand}" CommandParameter="{Binding}">
						<Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
							<TextBlock Classes="muted" Text="{Binding Number}" FontSize="13" VerticalAlignment="Center" />
							<StackPanel Grid.Column="1" VerticalAlignment="Center">
								<TextBlock Classes="chapterTitle" Classes.played="{Binding IsPlayed}" Classes.current="{Binding IsCurrent}"
									Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" />
								<TextBlock Text="Playing" FontSize="11" Foreground="{StaticResource Lamp}" IsVisible="{Binding IsCurrent}" Margin="0,2,0,0" />
							</StackPanel>
							<TextBlock Grid.Column="2" Classes="muted" Text="{Binding LengthText}" FontSize="13" VerticalAlignment="Center" />
						</Grid>
					</Button>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>

	<!-- Bookmarks and clips saved on the device, plus any on Audible's older annotation server. -->
	<Grid RowDefinitions="Auto,*" Background="{StaticResource Ink}" IsVisible="{Binding IsAnnotationListOpen}">
		<Grid ColumnDefinitions="Auto,*" Margin="12,4,24,4">
			<Button Classes="transport" Width="48" Height="48" Command="{Binding HideAnnotationsCommand}" ToolTip.Tip="Close">
				<PathIcon Data="{StaticResource IconChevronDown}" />
			</Button>
			<TextBlock Grid.Column="1" Classes="bookTitle" Text="Bookmarks and clips" FontSize="22" VerticalAlignment="Center" Margin="4,0,0,0" />
		</Grid>
		<StackPanel Grid.Row="1" Margin="24,32,24,0" Spacing="10" IsVisible="{Binding !HasAnnotations}">
			<TextBlock Classes="bookTitle" Text="Nothing saved in this book yet" FontSize="18" />
			<TextBlock Classes="muted" TextWrapping="Wrap"
				Text="While listening, tap Bookmark to mark your place, or Clip to keep what you just heard. They are saved on this phone." />
		</StackPanel>
		<ListBox Grid.Row="1" Classes="chapters" ItemsSource="{Binding Annotations}" Background="Transparent" IsVisible="{Binding HasAnnotations}">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:AnnotationRowViewModel">
					<Grid ColumnDefinitions="*,Auto">
						<Button Classes="row" Background="Transparent" CornerRadius="0" Padding="24,14,8,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
							Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).OpenAnnotationCommand}" CommandParameter="{Binding}">
							<Grid ColumnDefinitions="28,*" ColumnSpacing="8">
								<Panel VerticalAlignment="Center">
									<PathIcon Data="{StaticResource IconClip}" Width="16" Height="16" Foreground="{StaticResource Lamp}" IsVisible="{Binding IsClip}" />
									<PathIcon Data="{StaticResource IconBookmark}" Width="16" Height="16" Foreground="{StaticResource Lamp}" IsVisible="{Binding !IsClip}" />
								</Panel>
								<StackPanel Grid.Column="1">
									<TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
									<TextBlock Classes="muted" Text="{Binding DetailText}" FontSize="12" TextWrapping="Wrap" />
									<TextBlock Text="{Binding Note}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="{Binding HasNote}" />
								</StackPanel>
							</Grid>
						</Button>
						<Button Grid.Column="1" Classes="transport" Width="40" Height="48" Margin="0,0,12,0" ToolTip.Tip="More">
							<PathIcon Data="{StaticResource IconMore}" Width="18" Height="18" Foreground="{StaticResource Dust}" />
							<Button.Flyout>
								<MenuFlyout Placement="BottomEdgeAlignedRight">
									<MenuItem Header="Delete"
										Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).DeleteAnnotationCommand}" CommandParameter="{Binding}" />
								</MenuFlyout>
							</Button.Flyout>
						</Button>
						<Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Margin="24,0,0,0" Background="{StaticResource Hairline}" />
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>

	<!-- This book's listening history: when and where each session went, to find the place again after dozing off. -->
	<Grid RowDefinitions="Auto,*" Background="{StaticResource Ink}" IsVisible="{Binding IsHistoryOpen}">
		<Grid ColumnDefinitions="Auto,*" Margin="12,4,24,4">
			<Button Classes="transport" Width="48" Height="48" Command="{Binding HideHistoryCommand}" ToolTip.Tip="Close">
				<PathIcon Data="{StaticResource IconChevronDown}" />
			</Button>
			<TextBlock Grid.Column="1" Classes="bookTitle" Text="Listening history" FontSize="22" VerticalAlignment="Center" Margin="4,0,0,0" />
		</Grid>
		<StackPanel Grid.Row="1" Margin="24,32,24,0" Spacing="10" IsVisible="{Binding !HasHistory}">
			<TextBlock Classes="bookTitle" Text="No listening yet" FontSize="18" />
			<TextBlock Classes="muted" TextWrapping="Wrap"
				Text="Each time you listen, this shows when and where in the book, with your place every 5 minutes. Tap a time to go back there." />
		</StackPanel>
		<ScrollViewer Grid.Row="1" IsVisible="{Binding HasHistory}">
			<ItemsControl ItemsSource="{Binding History}" Margin="24,4,24,20">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:HistorySessionViewModel">
						<StackPanel Spacing="4" Margin="0,10,0,10">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="{Binding Header}" FontSize="15" />
								<TextBlock Text="Listening" FontSize="11" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
							</StackPanel>
							<TextBlock Classes="muted" Text="{Binding DetailText}" FontSize="12" />
							<TextBlock Text="{Binding AsleepText}" FontSize="12" Foreground="{StaticResource Lamp}" TextWrapping="Wrap" IsVisible="{Binding HasAsleep}" />
							<ItemsControl ItemsSource="{Binding Points}" Margin="0,4,0,0">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:HistoryPointViewModel">
										<Button Classes="quiet" Padding="10,6" Margin="0,0,6,6" Classes.asleep="{Binding IsAsleep}"
											Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).JumpToHistoryCommand}" CommandParameter="{Binding}">
											<StackPanel>
												<TextBlock Text="{Binding TimeText}" FontSize="13" />
												<TextBlock Classes="muted" Text="{Binding PositionText}" FontSize="11" />
											</StackPanel>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Border Height="1" Background="{StaticResource Hairline}" Margin="0,6,0,0" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>

	<!-- New clip, after Audible's: the clip over a waveform of what was just heard, dragged into place and previewed. -->
	<Grid RowDefinitions="Auto,*" Background="{StaticResource Ink}" IsVisible="{Binding IsClipEditorOpen}">
		<Grid ColumnDefinitions="Auto,*,Auto" Margin="8,4,16,4">
			<Button Classes="quiet" Content="Cancel" Padding="10,8" Command="{Binding CancelClipCommand}" />
			<TextBlock Grid.Column="1" Classes="bookTitle" Text="New clip" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
			<Button Grid.Column="2" Content="Save" Padding="18,8" CornerRadius="16" Command="{Binding SaveClipCommand}"
				Background="{StaticResource Lamp}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" />
		</Grid>
		<ScrollViewer Grid.Row="1">
			<StackPanel Margin="20,4,20,24" Spacing="14" DataContext="{Binding ClipEditor}" x:DataType="vm:ClipEditorViewModel">
				<TextBlock Classes="muted" Text="{Binding ContextText}" FontSize="13" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
				<StackPanel HorizontalAlignment="Center" Spacing="2">
					<TextBlock Text="{Binding RangeText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="44" HorizontalAlignment="Center" />
					<TextBlock Classes="muted" Text="{Binding FromToText}" FontSize="13" HorizontalAlignment="Center" />
				</StackPanel>

				<!-- The waveform, with preview: play from the clip's start, the line follows. -->
				<Border Background="{StaticResource Slate}" CornerRadius="8" Padding="10,12">
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<Button Classes="transport play" Width="52" Height="52" VerticalAlignment="Center"
							Command="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).PreviewClipCommand}" ToolTip.Tip="Play clip">
							<Panel>
								<PathIcon Data="{StaticResource IconPlay}" Margin="4,0,0,0"
									IsVisible="{Binding !$parent[UserControl].((vm:NowPlayingViewModel)DataContext).IsPlaying}" />
								<PathIcon Data="{StaticResource IconPause}"
									IsVisible="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).IsPlaying}" />
							</Panel>
						</Button>
						<controls:ClipRange Grid.Column="1" Height="96"
							WindowStart="{Binding WindowStartSeconds}" WindowEnd="{Binding WindowEndSeconds}"
							Start="{Binding StartSeconds}" End="{Binding EndSeconds}"
							MinimumLength="{Binding MinimumSeconds}" MaximumLength="{Binding MaximumSeconds}"
							Peaks="{Binding Peaks}"
							Playhead="{Binding $parent[UserControl].((vm:NowPlayingViewModel)DataContext).ClipPreviewSeconds}" />
					</Grid>
				</Border>
				<TextBlock Classes="muted" Text="Drag the ends to trim, or the middle to move the clip. Up to 45 seconds." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />

				<!-- Fine adjustment, a tenth or half a second at a time. -->
				<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
					<Border Background="{StaticResource Slate}" CornerRadius="8" Padding="12,10">
						<StackPanel Spacing="6">
							<TextBlock Classes="muted" Text="Start" FontSize="12" />
							<TextBlock Text="{Binding StartText}" FontSize="17" />
							<UniformGrid Columns="2">
								<Button Classes="quiet" Content="−0.5 s" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding NudgeStartCommand}" CommandParameter="-0.5" />
								<Button Classes="quiet" Content="+0.5 s" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding NudgeStartCommand}" CommandParameter="0.5" />
							</UniformGrid>
						</StackPanel>
					</Border>
					<Border Grid.Column="1" Background="{StaticResource Slate}" CornerRadius="8" Padding="12,10">
						<StackPanel Spacing="6">
							<TextBlock Classes="muted" Text="End" FontSize="12" />
							<TextBlock Text="{Binding EndText}" FontSize="17" />
							<UniformGrid Columns="2">
								<Button Classes="quiet" Content="−0.5 s" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding NudgeEndCommand}" CommandParameter="-0.5" />
								<Button Classes="quiet" Content="+0.5 s" Padding="6,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding NudgeEndCommand}" CommandParameter="0.5" />
							</UniformGrid>
						</StackPanel>
					</Border>
				</Grid>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
					<TextBlock Classes="muted" Text="Last" FontSize="13" VerticalAlignment="Center" />
					<Button Classes="quiet" Content="15 s" Padding="12,6" Command="{Binding SetLengthCommand}" CommandParameter="15" />
					<Button Classes="quiet" Content="30 s" Padding="12,6" Command="{Binding SetLengthCommand}" CommandParameter="30" />
					<Button Classes="quiet" Content="45 s" Padding="12,6" Command="{Binding SetLengthCommand}" CommandParameter="45" />
				</StackPanel>

				<StackPanel Spacing="6">
					<TextBox Text="{Binding Title}" PlaceholderText="Title (optional)" MaxLength="100" />
					<TextBox Text="{Binding Note}" PlaceholderText="Note (optional)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxLength="1000" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
	</Panel>
</UserControl>
