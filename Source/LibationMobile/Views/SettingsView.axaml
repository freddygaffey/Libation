<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LibationMobile.ViewModels"
             x:Class="LibationMobile.Views.SettingsView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource Ink}">

	<UserControl.Styles>
		<Style Selector="Button.choice">
			<Setter Property="Background" Value="{StaticResource Slate}" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
			<Setter Property="Padding" Value="14,10" />
			<Setter Property="Margin" Value="0,0,8,0" />
			<Setter Property="MinWidth" Value="56" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="Button.choice.selected">
			<Setter Property="Background" Value="{StaticResource Lamp}" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>
		<Style Selector="Button.choice:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{Binding $parent[Button].Background}" />
			<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
		</Style>
		<Style Selector="TextBlock.section">
			<Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
			<Setter Property="FontSize" Value="20" />
			<Setter Property="Margin" Value="0,28,0,10" />
		</Style>
		<Style Selector="TextBlock.setting">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="Margin" Value="0,8,0,8" />
		</Style>
		<Style Selector="Button.profile">
			<Setter Property="Background" Value="{StaticResource Slate}" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Padding" Value="14,12" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="BorderBrush" Value="Transparent" />
		</Style>
		<Style Selector="Button.profile.active">
			<Setter Property="BorderBrush" Value="{StaticResource Lamp}" />
		</Style>
		<Style Selector="Button.profile:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Slate}" />
			<Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
		</Style>
		<Style Selector="Button.settingsRow">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Padding" Value="12,10" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>
		<Style Selector="Button.settingsRow:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.settingsRow:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Hairline}" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">
		<Grid ColumnDefinitions="Auto,*" Margin="12,4,24,4">
			<!-- Down to close on the front page; back to it from a group. -->
			<Panel>
				<Button Classes="transport" Width="48" Height="48" Command="{Binding GoToLibraryCommand}" ToolTip.Tip="Close settings" IsVisible="{Binding Settings.IsRootPage}">
					<PathIcon Data="{StaticResource IconChevronDown}" />
				</Button>
				<Button Classes="transport" Width="48" Height="48" Command="{Binding Settings.OpenPageCommand}" CommandParameter="" ToolTip.Tip="Back" IsVisible="{Binding !Settings.IsRootPage}">
					<PathIcon Data="{StaticResource IconChevronDown}" RenderTransform="rotate(90deg)" />
				</Button>
			</Panel>
			<TextBlock Grid.Column="1" Classes="bookTitle" Text="{Binding Settings.PageTitle}" FontSize="22" VerticalAlignment="Center" Margin="4,0,0,0" />
		</Grid>

		<ScrollViewer Grid.Row="1" Name="settingsScroll">
			<StackPanel Margin="20,0,20,32" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
				<!-- The front page: one row per group, each with what it is set to now. -->
				<StackPanel IsVisible="{Binding IsRootPage}" Spacing="2" Margin="0,8,0,0">
				<Border Background="{StaticResource Slate}" CornerRadius="10" Padding="4,4" Margin="0,0,0,14">
					<StackPanel>
					<Button Classes="settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="speed">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
							<Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Lamp}">
								<PathIcon Data="{StaticResource IconSpeed}" Width="18" Height="18" Foreground="{StaticResource Ink}" />
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Speed" FontSize="16" />
								<TextBlock Classes="muted" Text="{Binding SpeedSummary}" FontSize="12" TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Foreground="{StaticResource Dust}" RenderTransform="rotate(-90deg)" />
						</Grid>
					</Button>
					<Button Classes="settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="training">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
							<Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Lamp}">
								<PathIcon Data="{StaticResource IconTraining}" Width="18" Height="18" Foreground="{StaticResource Ink}" />
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Training" FontSize="16" />
								<TextBlock Classes="muted" Text="{Binding TrainingSummary}" FontSize="12" TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Foreground="{StaticResource Dust}" RenderTransform="rotate(-90deg)" />
						</Grid>
					</Button>
					</StackPanel>
				</Border>
				<Border Background="{StaticResource Slate}" CornerRadius="10" Padding="4,4" Margin="0,0,0,14">
					<StackPanel>
					<Button Classes="settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="playback">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
							<Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Lamp}">
								<PathIcon Data="{StaticResource IconPlay}" Width="18" Height="18" Foreground="{StaticResource Ink}" />
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Playback" FontSize="16" />
								<TextBlock Classes="muted" Text="{Binding PlaybackSummary}" FontSize="12" TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Foreground="{StaticResource Dust}" RenderTransform="rotate(-90deg)" />
						</Grid>
					</Button>
					<Button Classes="settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="siri">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
							<Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Lamp}">
								<PathIcon Data="{StaticResource IconMic}" Width="18" Height="18" Foreground="{StaticResource Ink}" />
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Siri and voice" FontSize="16" />
								<TextBlock Classes="muted" Text="{Binding SiriSummary}" FontSize="12" TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Foreground="{StaticResource Dust}" RenderTransform="rotate(-90deg)" />
						</Grid>
					</Button>
					<Button Classes="settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="timesaved">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
							<Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Lamp}">
								<PathIcon Data="{StaticResource IconHistory}" Width="18" Height="18" Foreground="{StaticResource Ink}" />
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Time saved" FontSize="16" />
								<TextBlock Classes="muted" Text="{Binding TimeSavedSummary}" FontSize="12" TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Foreground="{StaticResource Dust}" RenderTransform="rotate(-90deg)" />
						</Grid>
					</Button>
					</StackPanel>
				</Border>
				<Border Background="{StaticResource Slate}" CornerRadius="10" Padding="4,4">
					<StackPanel>
					<Button Classes="settingsRow" Command="{Binding OpenPageCommand}" CommandParameter="sync">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
							<Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Lamp}">
								<PathIcon Data="{StaticResource IconRefresh}" Width="18" Height="18" Foreground="{StaticResource Ink}" />
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="Sync and downloads" FontSize="16" />
								<TextBlock Classes="muted" Text="{Binding SyncSummary}" FontSize="12" TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Foreground="{StaticResource Dust}" RenderTransform="rotate(-90deg)" />
						</Grid>
					</Button>
					</StackPanel>
				</Border>
				<!-- Signing out, at the foot: Audible's account, which the library needs. -->
				<Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,12" Margin="0,18,0,0"
					Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SignOutCommand}">
					<StackPanel Spacing="2">
						<TextBlock Text="Sign out" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource Lamp}" />
						<TextBlock Classes="muted" Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AccountText}" FontSize="12" HorizontalAlignment="Center" />
					</StackPanel>
				</Button>
				</StackPanel>
				<!-- Speed -->
				<StackPanel IsVisible="{Binding IsSpeedPage}">
				<TextBlock Classes="section" Text="Profiles" Margin="0,8,0,10" />
				<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"
					Text="Tap one to switch the speed and every speed-up setting below at once. To make one your own, change the settings, then Save current settings." />
				<!-- Each profile as a card: what it is for, and exactly what it sets. -->
				<ItemsControl ItemsSource="{Binding Profiles}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ProfileChoice">
							<Button Classes="profile" Classes.active="{Binding IsActive}" Margin="0,0,0,8"
								Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Settings.ApplyProfileCommand}" CommandParameter="{Binding}">
								<StackPanel Spacing="3">
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
										<TextBlock Grid.Column="1" Text="In use" FontSize="12" Foreground="{StaticResource Lamp}" IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
									</Grid>
									<TextBlock Text="{Binding Purpose}" FontSize="13" TextWrapping="Wrap" />
									<TextBlock Classes="muted" Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" />
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<TextBlock Text="{Binding ActiveProfileText}" FontSize="13" Foreground="{StaticResource Lamp}" TextWrapping="Wrap" Margin="0,0,0,8" />
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsVisible="{Binding HasActiveProfile}">
					<Button Classes="quiet" Content="Save current settings" Padding="12,8" Margin="0,0,8,0" Command="{Binding SaveProfileCommand}" />
					<Button Classes="quiet" Content="Reset" Padding="12,8" Command="{Binding ResetProfileCommand}" />
				</StackPanel>
				<TextBlock Classes="section" Text="How speech is sped up" />
				<TextBlock Classes="setting" Text="Speed-up method" Margin="0,0,0,8" />
				<StackPanel Orientation="Horizontal">
					<Button Classes="choice" Classes.selected="{Binding IsNonlinearMethod}" Content="Speedy" IsEnabled="{Binding NonlinearAvailable}" Command="{Binding SetSpeedMethodCommand}" CommandParameter="nonlinear" />
					<Button Classes="choice" Classes.selected="{Binding IsClassicMethod}" Content="Original" Command="{Binding SetSpeedMethodCommand}" CommandParameter="classic" />
				</StackPanel>
				<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,16"
					Text="Speedy hurries vowels and pauses and keeps consonants closer to normal length, the way a fast talker speaks. Original speeds everything up by the same amount. You can switch while a book plays." />
				<Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsNonlinearMethod}">
					<TextBlock Text="Keep consonants clear" FontSize="15" VerticalAlignment="Center" />
					<TextBlock Grid.Column="1" Text="{Binding NonlinearityText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
				</Grid>
				<Slider Classes="scrubber" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Nonlinearity}" IsVisible="{Binding IsNonlinearMethod}" />
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsVisible="{Binding IsNonlinearMethod}">
					<Button Classes="quiet" Content="Even" Padding="12,8" Margin="0,0,8,0" Command="{Binding SetNonlinearityCommand}" CommandParameter="0" />
					<Button Classes="quiet" Content="Full" Padding="12,8" Command="{Binding SetNonlinearityCommand}" CommandParameter="100" />
				</StackPanel>
				<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding IsNonlinearMethod}"
					Text="How strongly Speedy treats sounds differently. Full is how it was designed; lower settings move towards even speed-up." />
				<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0" IsVisible="{Binding !NonlinearAvailable}"
					Text="This device could not load Speedy, so the original method is used." />
				<TextBlock Classes="section" Text="Advanced: very high speeds" />
				<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"
					Text="For 5× and faster. Each one changes how the time is spent, not the speed you set. They take effect while a book plays, so you can compare by ear." />
				<StackPanel Margin="0,4,0,12">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Shorten pauses to" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding PauseCapText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="0" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding PauseCapMs}" />
					<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="Every pause is cut to at most this before speeding up, so the speed goes to the words. Around 60 ms keeps just enough to hear that there was a pause." />
				</StackPanel>
				<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="Keep the overall speed" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="With pauses shortened or rhythm on, the book still finishes at the speed set: time saved in pauses plays the words slower. Off, shortened pauses simply make it faster." />
					</StackPanel>
					<ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepSpeed}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
				<StackPanel Margin="0,4,0,12" IsVisible="{Binding UsesSpeedySpeedUp}">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Speed floor" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding SpeedFloorText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="0" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SpeedFloorPercent}" />
					<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="Speedy slows the hardest sounds, sometimes to normal speed, and races the rest to make up for it. A floor of 50% keeps every part at half the speed or more: at 8×, never below 4×." />
				</StackPanel>
				<StackPanel Margin="0,4,0,12">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Rhythm gaps" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding RhythmGapText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding RhythmGapMs}" />
					<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="Short silences at a steady beat. At 3× they made squeezed speech much easier to follow, but the words play faster to make room, and 40 ms felt like too much at high speed. If you try them, start at 10 to 20 ms." />
				</StackPanel>
				<StackPanel Margin="0,4,0,12" IsVisible="{Binding RhythmOn}">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Gaps a second" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding RhythmRateText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="2" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding RhythmRate}" />
					<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="Near the beat of syllables, about 4 to 8 a second." />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<Button Classes="quiet" Content="Suggested" Padding="12,8" Margin="0,0,8,0" Command="{Binding SuggestHighSpeedCommand}" />
					<Button Classes="quiet" Content="All off" Padding="12,8" Command="{Binding ResetHighSpeedCommand}" />
				</StackPanel>
				<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
					Text="Suggested: pauses shortened to 60 ms, keep the overall speed, floor at 50%. Rhythm is left off: it felt like too much in use, and whether it helps above 3× is not known." />
				</StackPanel>
				<!-- Training -->
				<StackPanel IsVisible="{Binding IsTrainingPage}">
				<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="Training mode" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="Each time you start listening, warm up from a little slower and step up to the book's speed. Ears adapt to fast speech within minutes, and lose some of it between sessions. Changing the speed yourself during the warm-up moves it: the climb carries on from there." />
					</StackPanel>
					<ToggleSwitch Grid.Column="1" IsChecked="{Binding Training}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
				<StackPanel IsVisible="{Binding Training}">
				<TextBlock Classes="setting" Text="Start the warm-up" />
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<Button Classes="choice" Classes.selected="{Binding TrainingFromBelow}" Content="Below the book's speed" Command="{Binding SetTrainingFromCommand}" CommandParameter="below" />
					<Button Classes="choice" Classes.selected="{Binding TrainingFromSpeed}" Content="At a set speed" Command="{Binding SetTrainingFromCommand}" CommandParameter="speed" />
				</StackPanel>
				<StackPanel Margin="0,4,0,12" IsVisible="{Binding TrainingFromBelow}">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Start" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding TrainingStartBelowText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="0.25" Maximum="5" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding TrainingStartBelow}" />
					<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="At 6×, 1× below starts at 5× and climbs back up. Never below 1×." />
				</StackPanel>
				<StackPanel Margin="0,4,0,12" IsVisible="{Binding TrainingFromSpeed}">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Start at" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding TrainingStartText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding TrainingStartSpeed}" />
					<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="A speed you can follow with no warm-up. Books set at or below it start at their own speed." />
				</StackPanel>
				<StackPanel Margin="0,4,0,12">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Step up by" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding TrainingStepText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="0.05" Maximum="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding TrainingStep}" />
				</StackPanel>
				<StackPanel Margin="0,4,0,12">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Every" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding TrainingMinutesText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding TrainingMinutes}" />
					<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="Minutes of listening, not of the clock." />
				</StackPanel>
				<StackPanel Margin="0,4,0,12">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Warm up again after a break of" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding TrainingRestartText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TrainingRestartMinutes}" />
					<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="A shorter pause carries on where the climb was." />
				</StackPanel>
				<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="Keep climbing" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="Carry on past the book's speed up to the ceiling below, and keep the speed reached for next time." />
					</StackPanel>
					<ToggleSwitch Grid.Column="1" IsChecked="{Binding TrainingClimb}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
				<StackPanel Margin="0,4,0,12" IsVisible="{Binding TrainingClimb}">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Ceiling" FontSize="15" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding TrainingCeilingText}" FontSize="15" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" />
					</Grid>
					<Slider Classes="scrubber" Minimum="1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding TrainingCeiling}" />
				</StackPanel>
				</StackPanel>
				<TextBlock Classes="section" Text="Measuring" />
				<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="Ask how well I followed" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="After a session of 5 minutes or more, one tap from 1 to 5. Saved with the speed, syllables a second and settings, for your own research on the stats page." />
					</StackPanel>
					<ToggleSwitch Grid.Column="1" IsChecked="{Binding AskFollowRating}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
				<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="Show syllables a second" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Text="Under the speed in the player, measured from the audio. The usual measure in speech research: untrained listeners manage about 8, trained blind screen-reader users 17 to 22." />
					</StackPanel>
					<ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowSyllableRate}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
				</StackPanel>
				<!-- Playback -->
				<StackPanel IsVisible="{Binding IsPlaybackPage}">
				<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="Progress bar shows the chapter" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
							Text="The bar on the player runs from the start to the end of the chapter playing. Turn off to have it cover the whole book." />
					</StackPanel>
					<ToggleSwitch Grid.Column="1" IsChecked="{Binding ScrubByChapter}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
				<!-- Auto-pause when asleep -->
				<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="Pause when you fall asleep" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
							Text="After a while with no touch, and your head (with AirPods that report it) or the phone lying still, the sound fades for 30 seconds, then pauses. Touch anything to keep listening." />
					</StackPanel>
					<ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoPauseAsleep}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
				<StackPanel IsVisible="{Binding AutoPauseAsleep}" Margin="0,0,0,12">
					<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12" Text="{Binding MotionStatus}" Foreground="{StaticResource Lamp}" />
					<TextBlock Classes="setting" Text="Asleep after no touch for" />
					<StackPanel Orientation="Horizontal">
						<Button Classes="choice" Classes.selected="{Binding IsAsleep10}" Content="10 min" Command="{Binding SetAsleepMinutesCommand}" CommandParameter="10" />
						<Button Classes="choice" Classes.selected="{Binding IsAsleep20}" Content="20 min" Command="{Binding SetAsleepMinutesCommand}" CommandParameter="20" />
						<Button Classes="choice" Classes.selected="{Binding IsAsleep30}" Content="30 min" Command="{Binding SetAsleepMinutesCommand}" CommandParameter="30" />
						<Button Classes="choice" Classes.selected="{Binding IsAsleep45}" Content="45 min" Command="{Binding SetAsleepMinutesCommand}" CommandParameter="45" />
					</StackPanel>
					<Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
						<TextBlock Text="Only from 9 p.m. to 7 a.m." FontSize="14" VerticalAlignment="Center" />
						<ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoPauseNightOnly}" OnContent="" OffContent="" Margin="12,0,0,0" />
					</Grid>
				</StackPanel>
				<!-- Hidden until the app ID carries the HealthKit capability; without it iOS will not ask. -->
				<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16" IsVisible="False">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="Sleep from Apple Health" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
							Text="Your watch's sleep record (Garmin Connect or Apple Watch, through Apple Health) marks where in a book you fell asleep, in its history, once the watch syncs." />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12" Text="{Binding HealthStatus}" Foreground="{StaticResource Lamp}" />
					</StackPanel>
					<Button Grid.Column="1" Classes="quiet" Content="Connect" Padding="12,8" Margin="12,0,0,0" VerticalAlignment="Center"
						Command="{Binding ConnectHealthCommand}" IsVisible="{Binding !UseHealthSleep}" />
					<TextBlock Grid.Column="1" Text="Connected" FontSize="13" Foreground="{StaticResource Lamp}" Margin="12,0,0,0" VerticalAlignment="Center"
						IsVisible="{Binding UseHealthSleep}" />
				</Grid>
				<TextBlock Classes="setting" Text="Skip back and forward by" />
				<StackPanel Orientation="Horizontal">
					<Button Classes="choice" Classes.selected="{Binding IsSkip10}" Content="10 s" Command="{Binding SetSkipCommand}" CommandParameter="10" />
					<Button Classes="choice" Classes.selected="{Binding IsSkip15}" Content="15 s" Command="{Binding SetSkipCommand}" CommandParameter="15" />
					<Button Classes="choice" Classes.selected="{Binding IsSkip30}" Content="30 s" Command="{Binding SetSkipCommand}" CommandParameter="30" />
					<Button Classes="choice" Classes.selected="{Binding IsSkip60}" Content="60 s" Command="{Binding SetSkipCommand}" CommandParameter="60" />
				</StackPanel>
				<TextBlock Classes="setting" Text="A new clip starts as the last" Margin="0,20,0,8" />
				<StackPanel Orientation="Horizontal">
					<Button Classes="choice" Classes.selected="{Binding IsClip15}" Content="15 s" Command="{Binding SetClipCommand}" CommandParameter="15" />
					<Button Classes="choice" Classes.selected="{Binding IsClip30}" Content="30 s" Command="{Binding SetClipCommand}" CommandParameter="30" />
					<Button Classes="choice" Classes.selected="{Binding IsClip45}" Content="45 s" Command="{Binding SetClipCommand}" CommandParameter="45" />
				</StackPanel>
				</StackPanel>
				<!-- Siri and voice: every command, as tables. -->
				<StackPanel IsVisible="{Binding IsSiriPage}">
				<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"
					Text="Start with &quot;Hey Siri,&quot; then say Libation or Speed. After an update, open the app once so Siri learns the commands." />
				<TextBlock Classes="section" Text="Speed" Margin="0,18,0,8" />
				<Border Background="{StaticResource Slate}" CornerRadius="10" ClipToBounds="True">
					<StackPanel>
						<Border Padding="12,8" Background="{StaticResource Hairline}">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="Say" FontSize="12" FontWeight="SemiBold" />
								<TextBlock Grid.Column="1" Text="It does" FontSize="12" FontWeight="SemiBold" />
							</Grid>
						</Border>
						<Border Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Speed 7.3&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Sets 7.3×. Any tenth from 0.5× to 10×." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Background="{StaticResource Ink}" Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Set Libation to seven and a half&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Sets 7.5×. Halves can be said as fractions." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Speed faster&quot; · &quot;Speed slower&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Up or down by 0.5×." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Background="{StaticResource Ink}" Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Speed faster by 0.1&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Up by an amount: 0.1 to 2, or a tenth, a fifth, a half." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Slow down Libation by a half&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Down by an amount." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Background="{StaticResource Ink}" Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Speed 2&quot;, with a book playing" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Siri's own speed command, also works." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
					</StackPanel>
				</Border>
				<TextBlock Classes="section" Text="Playing" Margin="0,18,0,8" />
				<Border Background="{StaticResource Slate}" CornerRadius="10" ClipToBounds="True">
					<StackPanel>
						<Border Padding="12,8" Background="{StaticResource Hairline}">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="Say" FontSize="12" FontWeight="SemiBold" />
								<TextBlock Grid.Column="1" Text="It does" FontSize="12" FontWeight="SemiBold" />
							</Grid>
						</Border>
						<Border Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Speed play&quot; · &quot;Speed pause&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Play the last book (opens the app), or pause." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Background="{StaticResource Ink}" Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Pause&quot; · &quot;Resume&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Siri's own commands, for whatever is playing." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Speed list&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Reads your downloaded books, last listened first, numbered." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Background="{StaticResource Ink}" Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Speed play number 3&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Plays number 3 on that list." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Speed play a book&quot;, then &quot;Dune&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Plays a book by title, author or number." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Background="{StaticResource Ink}" Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Speed speed&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Tells you the speed and the time left." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
					</StackPanel>
				</Border>
				<TextBlock Classes="section" Text="In your own words" Margin="0,18,0,8" />
				<Border Background="{StaticResource Slate}" CornerRadius="10" ClipToBounds="True">
					<StackPanel>
						<Border Padding="12,8" Background="{StaticResource Hairline}">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="Say" FontSize="12" FontWeight="SemiBold" />
								<TextBlock Grid.Column="1" Text="It does" FontSize="12" FontWeight="SemiBold" />
							</Grid>
						</Border>
						<Border Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;Tell Libation&quot;, then anything" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Siri asks what to do. Say it your way:" FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Background="{StaticResource Ink}" Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;a bit faster&quot; · &quot;seven point three&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Changes the speed." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;slower by a tenth&quot; · &quot;minus 0.2&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Changes it by that much." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
						<Border Background="{StaticResource Ink}" Padding="12,9" CornerRadius="0">
							<Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
								<TextBlock Text="&quot;go back&quot; · &quot;pause&quot; · &quot;list my books&quot;" FontSize="14" TextWrapping="Wrap" />
								<TextBlock Grid.Column="1" Classes="muted" Text="Skips, pauses or lists." FontSize="13" TextWrapping="Wrap" />
							</Grid>
						</Border>
					</StackPanel>
				</Border>
				<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"
					Text="Every command is also an action in the Shortcuts app, with Set exact speed for any value. A shortcut you name yourself, such as &quot;faster&quot;, runs with no app name." />
				</StackPanel>
				<!-- Time saved -->
				<StackPanel IsVisible="{Binding IsTimeSavedPage}">
				<!-- Time saved: what the speed has bought against 1x, in Audible's app and in Libation. -->
				<Border Background="{StaticResource Slate}" CornerRadius="6" Padding="16,14" Margin="0,8,0,0">
					<StackPanel Spacing="4">
						<TextBlock Classes="muted" Text="Time saved" FontSize="13" />
						<TextBlock Text="{Binding TimeSavedText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="36"
							Foreground="{StaticResource Lamp}" TextWrapping="Wrap" />
						<TextBlock Classes="muted" Text="{Binding TimeSavedDetail}" FontSize="13" TextWrapping="Wrap" />
						<!-- Each app on a row: real (wall-clock) time, book time heard, time saved against 1x, and the speed. -->
						<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6" Margin="0,12,0,0">
							<TextBlock Grid.Column="1" Grid.Row="0" Text="Real time" HorizontalAlignment="Right" Classes="muted" FontSize="12" />
							<TextBlock Grid.Column="2" Grid.Row="0" Text="Book time" HorizontalAlignment="Right" Classes="muted" FontSize="12" />
							<TextBlock Grid.Column="3" Grid.Row="0" Text="Saved" HorizontalAlignment="Right" Classes="muted" FontSize="12" />
							<TextBlock Grid.Column="4" Grid.Row="0" Text="Speed" HorizontalAlignment="Right" Classes="muted" FontSize="12" />
							<TextBlock Grid.Row="1" Text="Audible app" FontSize="13" />
							<TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding AudibleRealText}" FontSize="13" HorizontalAlignment="Right" />
							<TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding AudibleBookText}" FontSize="13" HorizontalAlignment="Right" />
							<TextBlock Grid.Column="3" Grid.Row="1" Text="{Binding AudibleSavedText}" FontSize="13" HorizontalAlignment="Right" />
							<TextBlock Grid.Column="4" Grid.Row="1" Text="{Binding AudibleSpeedText}" FontSize="13" HorizontalAlignment="Right" />
							<TextBlock Grid.Row="2" Text="Libation" FontSize="13" />
							<TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding LibationRealText}" FontSize="13" HorizontalAlignment="Right" />
							<TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding LibationBookText}" FontSize="13" HorizontalAlignment="Right" />
							<TextBlock Grid.Column="3" Grid.Row="2" Text="{Binding LibationSavedText}" FontSize="13" HorizontalAlignment="Right" />
							<TextBlock Grid.Column="4" Grid.Row="2" Text="{Binding LibationSpeedText}" FontSize="13" HorizontalAlignment="Right" />
							<TextBlock Grid.Row="3" Text="Total" FontSize="13" FontWeight="SemiBold" />
							<TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding TotalRealText}" FontSize="13" HorizontalAlignment="Right" FontWeight="SemiBold" />
							<TextBlock Grid.Column="2" Grid.Row="3" Text="{Binding TotalBookText}" FontSize="13" HorizontalAlignment="Right" FontWeight="SemiBold" />
							<TextBlock Grid.Column="3" Grid.Row="3" Text="{Binding TotalSavedText}" FontSize="13" HorizontalAlignment="Right" FontWeight="SemiBold" />
							<TextBlock Grid.Column="4" Grid.Row="3" Text="{Binding TotalSpeedText}" FontSize="13" HorizontalAlignment="Right" FontWeight="SemiBold" />
						</Grid>
						<TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
							Text="Audible counts real time, so its book time is that times its speed. Libation's are measured as you listen." />
						<TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding AudibleSpeedSourceText}" />
						<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
							<TextBlock Text="Audible speed if it can't be worked out" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
							<Button Grid.Column="1" Classes="quiet" Content="−" Padding="14,6" Command="{Binding ChangeAudibleDefaultCommand}" CommandParameter="-0.1" />
							<TextBlock Grid.Column="2" Text="{Binding AudibleDefaultText}" FontSize="14" Foreground="{StaticResource Lamp}" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" />
							<Button Grid.Column="3" Classes="quiet" Content="+" Padding="14,6" Command="{Binding ChangeAudibleDefaultCommand}" CommandParameter="0.1" />
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Classes="quiet" Content="Listening log" Padding="12,8"
								Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowLogCommand}" />
						</StackPanel>
					</StackPanel>
				</Border>
				</StackPanel>
				<!-- Sync and downloads -->
				<StackPanel IsVisible="{Binding IsSyncPage}">
				<Grid ColumnDefinitions="*,Auto">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="Sync position with Audible" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
							Text="Pick up where you stopped on another device, and let other devices pick up from here." />
					</StackPanel>
					<ToggleSwitch Grid.Column="1" IsChecked="{Binding SyncPosition}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
				<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13" Margin="0,12,0,0"
					Text="Bookmarks and clips are kept on this phone." />
				<TextBlock Classes="section" Text="Downloads" />
				<Grid ColumnDefinitions="*,Auto">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="High quality" FontSize="15" />
						<TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
							Text="Better sound and larger files. Applies to books you download from now on." />
					</StackPanel>
					<ToggleSwitch Grid.Column="1" IsChecked="{Binding HighQualityDownloads}" OnContent="" OffContent="" Margin="12,0,0,0" />
				</Grid>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
