<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LibationMobile.ViewModels"
             x:Class="LibationMobile.Views.ListeningLogView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource Ink}">

	<UserControl.Styles>
		<Style Selector="Button.choice">
			<Setter Property="Background" Value="{StaticResource Slate}" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
			<Setter Property="Padding" Value="14,10" />
			<Setter Property="Margin" Value="0,0,8,0" />
			<Setter Property="MinWidth" Value="56" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="Button.choice.selected">
			<Setter Property="Background" Value="{StaticResource Lamp}" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>
		<Style Selector="Button.choice:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{Binding $parent[Button].Background}" />
			<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">
		<Grid ColumnDefinitions="Auto,*,Auto" Margin="12,4,16,4">
			<Button Classes="transport" Width="48" Height="48" Command="{Binding GoToLibraryCommand}" ToolTip.Tip="Back">
				<PathIcon Data="{StaticResource IconChevronDown}" />
			</Button>
			<TextBlock Grid.Column="1" Classes="bookTitle" Text="Listening stats" FontSize="22" VerticalAlignment="Center" Margin="4,0,0,0" />
			<Button Grid.Column="2" Classes="quiet" Content="Clear" Padding="10,6" Command="{Binding Log.ClearLogCommand}" IsVisible="{Binding !Log.IsEmpty}" />
		</Grid>

		<ScrollViewer Grid.Row="1">
			<StackPanel Margin="0,0,0,32">
				<!-- At a glance, as Audible's stats open: total, this month, streak, finished. -->
				<ItemsControl ItemsSource="{Binding Log.Tiles}" Margin="18,4,18,0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:StatTile">
							<Border Background="{StaticResource Slate}" CornerRadius="6" Padding="14,12" Margin="6">
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="26" />
									<TextBlock Classes="muted" Text="{Binding Label}" FontSize="12" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Listening by day or month: the Audible app and Libation stacked. -->
				<Border Background="{StaticResource Slate}" CornerRadius="6" Padding="14,12" Margin="24,8,24,0">
					<StackPanel Spacing="8">
						<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
							<Button Classes="choice" Classes.selected="{Binding Log.IsByDay}" Content="30 days" Command="{Binding Log.ShowByDayCommand}" />
							<Button Classes="choice" Classes.selected="{Binding Log.IsByMonth}" Content="12 months" Command="{Binding Log.ShowByMonthCommand}" />
							<Button Classes="choice" Classes.selected="{Binding Log.IsByYear}" Content="Years" Command="{Binding Log.ShowByYearCommand}" />
						</StackPanel>
						<Grid ColumnDefinitions="Auto,*,Auto">
							<Button Classes="transport" Width="40" Height="40" Command="{Binding Log.OlderCommand}" IsVisible="{Binding Log.CanPage}" ToolTip.Tip="Earlier">
								<PathIcon Data="{StaticResource IconChevronDown}" Width="16" Height="16" RenderTransform="rotate(90deg)" />
							</Button>
							<TextBlock Grid.Column="1" Text="{Binding Log.ChartTitle}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
							<Button Grid.Column="2" Classes="transport" Width="40" Height="40" Command="{Binding Log.NewerCommand}" IsVisible="{Binding Log.CanPage}" IsEnabled="{Binding Log.CanGoNewer}" ToolTip.Tip="Later">
								<PathIcon Data="{StaticResource IconChevronDown}" Width="16" Height="16" RenderTransform="rotate(-90deg)" />
							</Button>
						</Grid>
						<ItemsControl ItemsSource="{Binding Log.Bars}" Height="140">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ChartBar">
									<Grid RowDefinitions="*,Auto" ToolTip.Tip="{Binding ValueText}" Margin="1,0">
										<StackPanel VerticalAlignment="Bottom">
											<Border Height="{Binding LibationHeight}" Background="{StaticResource Lamp}" CornerRadius="2,2,0,0" />
											<Border Height="{Binding AudibleHeight}" Background="{StaticResource Dust}" />
										</StackPanel>
										<TextBlock Grid.Row="1" Classes="muted" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"
											IsVisible="{Binding ShowLabel}" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBlock Classes="muted" Text="{Binding Log.ChartTotalText}" FontSize="12" />
						<StackPanel Orientation="Horizontal" Spacing="14">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Lamp}" VerticalAlignment="Center" />
								<TextBlock Classes="muted" Text="Libation" FontSize="12" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="5">
								<Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Dust}" VerticalAlignment="Center" />
								<TextBlock Classes="muted" Text="Audible app" FontSize="12" />
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</Border>
				<Grid ColumnDefinitions="*,Auto" Margin="24,6,16,0">
					<TextBlock Classes="muted" Text="{Binding Log.AudibleStatus}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
					<Panel Grid.Column="1" Width="44" Height="44">
						<ProgressBar IsIndeterminate="True" IsVisible="{Binding Log.IsRefreshing}" MinWidth="0" Width="24" VerticalAlignment="Center" Foreground="{StaticResource Lamp}" />
						<Button Classes="transport" Width="44" Height="44" Command="{Binding Log.RefreshFromAudibleCommand}" IsVisible="{Binding !Log.IsRefreshing}" ToolTip.Tip="Get Audible's figures">
							<PathIcon Data="{StaticResource IconRefresh}" Width="18" Height="18" />
						</Button>
					</Panel>
				</Grid>

				<!-- The listener's own research: how well followed against syllables a second, and blind trial results. -->
				<TextBlock Text="Your research" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="24,20,24,4" />
				<TextBlock Classes="muted" Text="{Binding Log.ResearchSummary}" FontSize="13" TextWrapping="Wrap" Margin="24,0,24,8" />
				<Border Background="{StaticResource Slate}" CornerRadius="6" Padding="14,12" Margin="24,0,24,8" IsVisible="{Binding Log.FollowBars.Count}">
					<StackPanel Spacing="6">
						<TextBlock Text="How well you followed, by syllables a second" FontSize="14" />
						<ItemsControl ItemsSource="{Binding Log.FollowBars}" Height="84">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:FollowBar">
									<Grid RowDefinitions="*,Auto" Width="30" ToolTip.Tip="{Binding ValueText}">
										<Border Height="{Binding Height}" VerticalAlignment="Bottom" Background="{StaticResource Lamp}" CornerRadius="2,2,0,0" />
										<TextBlock Grid.Row="1" Classes="muted" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBlock Classes="muted" Text="Bar height: average rating out of 5. Label: syllables a second, from." FontSize="11" />
					</StackPanel>
				</Border>
				<StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,24,8">
					<Button Classes="quiet" Content="Copy research data" Padding="12,8" Click="CopyResearch_Click" />
					<Button Classes="quiet" Content="Save as a file…" Padding="12,8" Click="SaveResearch_Click" />
				</StackPanel>
				<ItemsControl ItemsSource="{Binding Log.Research}" Margin="24,0,24,0">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ResearchRow">
							<Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="0,8">
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding Title}" FontSize="15" />
									<ItemsControl ItemsSource="{Binding Lines}">
										<ItemsControl.ItemTemplate>
											<DataTemplate><TextBlock Classes="muted" Text="{Binding}" FontSize="12" TextWrapping="Wrap" /></DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Text="{Binding Verdict}" FontSize="12" Foreground="{StaticResource Lamp}" IsVisible="{Binding Verdict, Converter={x:Static ObjectConverters.IsNotNull}}" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Finished on Audible, newest first. -->
				<StackPanel IsVisible="{Binding Log.HasFinished}" Margin="0,16,0,0">
					<TextBlock Text="Recently finished" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="24,0,24,6" />
					<ItemsControl ItemsSource="{Binding Log.Finished}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:FinishedRow">
								<Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="24,8">
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
										<StackPanel>
											<TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
											<TextBlock Classes="muted" Text="{Binding Author}" FontSize="12" TextTrimming="CharacterEllipsis" />
										</StackPanel>
										<TextBlock Grid.Column="1" Classes="muted" Text="{Binding DateText}" FontSize="12" VerticalAlignment="Center" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<!-- Each day's sessions on this phone. -->
				<TextBlock Text="Sessions in Libation" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="24,20,24,0" />
				<TextBlock Classes="muted" TextWrapping="Wrap" Margin="24,6,24,0" IsVisible="{Binding Log.IsEmpty}"
					Text="Each time you listen for more than half a minute, it is noted here: when, which book, for how long, and how much of the book that covered. Each book's own history is under History in the player." />
				<ItemsControl ItemsSource="{Binding Log.Days}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:LogDayViewModel">
							<StackPanel Margin="0,16,0,0">
								<TextBlock Text="{Binding Header}" FontSize="16" Margin="24,0" />
								<TextBlock Classes="muted" Text="{Binding TotalText}" FontSize="13" Margin="24,2,24,6" />
								<ItemsControl ItemsSource="{Binding Entries}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:LogEntryViewModel">
											<Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hairline}" Padding="24,10">
												<StackPanel Spacing="2">
													<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
														<TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
														<TextBlock Grid.Column="1" Classes="muted" Text="{Binding TimeText}" FontSize="13" />
													</Grid>
													<TextBlock Classes="muted" Text="{Binding DetailText}" FontSize="12" TextWrapping="Wrap" />
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
